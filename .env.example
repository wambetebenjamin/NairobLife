# Kanairo needs no environment variables to run. There is no backend yet.
#
# This file lists the ones later phases will use, so the names are agreed early.
# Copy it to .env.local and fill in values when you reach that phase.
# Never commit real keys: .env and .env.* are git-ignored.
#
# Anything the browser must read has to start with VITE_ (Vite only exposes those).

# --- Phase 5: multiplayer (Supabase: accounts, presence, saved progress) ---------------
# Project URL and the public "anon" key, from Supabase > Project Settings > API.
# The anon key is safe to ship to browsers as long as Row Level Security is switched on.
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=

# --- Map pipeline (optional) -----------------------------------------------------------
# Use a specific Overpass server for `npm run osm:fetch` instead of the built-in list.
# OVERPASS_URL=https://overpass-api.de/api/interpreter
