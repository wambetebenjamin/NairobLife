# dependencies
node_modules/

# build output
dist/
*.tsbuildinfo

# local env (never commit secrets; see .env.example)
.env
.env.*
!.env.example

# tooling
.vercel/
.eslintcache
coverage/
*.log

# editors / OS
.DS_Store
Thumbs.db
.idea/
